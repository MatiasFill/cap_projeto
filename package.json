{
  "name": "cap_finance",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js/postgres": "^2.0.5",
    "@sap/cds": "^9",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/ux-ui5-tooling": "^1.19.1",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-app-catecories": "cds watch --open app-catecories/webapp/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-app-wallets": "cds watch --open app-wallets/webapp/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-app-movements": "cds watch --open app-movements/webapp/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-app-movements-types": "cds watch --open app-movements-types/webapp/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/app-catecories",
    "app/app-wallets",
    "app/app-movements",
    "app/app-movements-types"
  ]
}
